/* scroll bar settings */
QScrollBar::up-arrow:vertical {
  image: url("$PATHPLACEHOLDER/styles/iconmonstr-caret-up-filled.svg");
}

QScrollBar::down-arrow:vertical {
  image: url("$PATHPLACEHOLDER/styles/iconmonstr-caret-down-filled.svg");
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
  background: none;
}

QScrollBar:vertical {
  width: 25px;
  margin: 30px 2px 30px 2px;
  border-radius: 4px;
}
QScrollBar::handle:vertical {
  background-color: #BBBBBB;
  border: 1px solid #C0C4C8;
  border-radius: 4px;
  min-height: 16px;
}

QScrollBar::handle:vertical:hover {
  background-color: #9FCBFF;
  border: #9FCBFF;
  border-radius: 4px;
  min-height: 16px;
}

QScrollBar::handle:vertical:focus {
  border: 1px solid #73C7FF;
    min-height: 16px;

}

QScrollBar::add-line:vertical {
    margin: 3px 0px 3px 0px;
    border-radius: 4px;
    height: 25px;
    width: 25px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}

QScrollBar::add-line:vertical:hover, QScrollBar::add-line:vertical:on {
    background-color: #9FCBFF;
    height: 25px;
    width: 25px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical {
    margin: 3px 0px 3px 0px;
    border-radius: 4px;
    height: 25px;
    width: 25px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical:hover, QScrollBar::sub-line:vertical:on {
    background-color: #9FCBFF;
    height: 25px;
    width: 25px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

/* tab widget settings */

QTabWidget QToolButton {
    border-radius: 4px;
    border-width: 2px;
    margin: 1px 2px 2px 2px;
    font: arial;
    font-size: $FONTSIZEPLACEHOLDER*1.25;
}

QTabBar::scroller { /* the width of the scroll buttons */
    width: 50px;
    height: 30px;
    margin: 0px 4px 0px 0px;

}

QTabBar QToolButton {
    border-radius: 4px;
    border-width: 2px;
    margin: 2px 2px 2px 2px;
}

/* other settings */

QPushButton:hover {
    background-color: #9FCBFF;
}

QComboBox {
    min-height: 35px;
}

QToolButton:hover {
    background-color: #99ccff;
    border-color: #A0A0A0;
}

/* style for window types : */

QWidget {
font: $FONTPLACEHOLDER;
font-size: $FONTSIZEPLACEHOLDER*1;
}

MainWindow{
font: $FONTPLACEHOLDER;
font-size: $FONTSIZEPLACEHOLDER*2;
}


SetOpWindow {
font: $FONTPLACEHOLDER;
font-size: $FONTSIZEPLACEHOLDER*2;
}

TabPage {
font: $FONTPLACEHOLDER;
font-size: $FONTSIZEPLACEHOLDER*2;
}


DataView > QLabel {
font: $FONTPLACEHOLDER;
font-size: $FONTSIZEPLACEHOLDER*2;
}


QGroupBox {
font: bold;
font-size: $FONTSIZEPLACEHOLDER;
}


QLabel {
font: $FONTPLACEHOLDER;
font-size: $FONTSIZEPLACEHOLDER*1;
}


QPushButton {
font: bold;
font-size: $FONTSIZEPLACEHOLDER*1;
}

/* Primary action buttons: the single main "go" action of a window/screen
   (e.g. "Load", "Apply", "Create Pipeline", "Run", "Start <function>").
   Marked in Python with btn.setProperty('class', 'primary') and re-polished.
   Filled with Material Design Blue 700 (#1976d2) - a calm, unambiguous "go"
   accent, and the same accent used for ToggleSwitch's "on" state, so the accent
   is consistent app-wide. The primary/secondary distinction is carried by *both*
   color and fill (solid accent vs. the default flat/bordered look of ordinary
   buttons) so it still reads under grayscale or color-blind viewing, not by hue
   alone. Blue 700 is dark, so the label text is white rather than near-black:
   white-on-#1976d2 is ~4.6:1 (>= AA), rising to ~5.8:1 / ~8.6:1 on the
   hover/pressed fills (Blue 800 / Blue 900) below. The fill colors are constant
   across the "base"/"light"/"dark" app themes (this stylesheet is prepended to
   the qdarkstyle sheet, and the attribute selector out-specifies qdarkstyle's
   plain QPushButton rules), so primary buttons look the same regardless of theme
   while still sitting correctly against each theme's background. */
QPushButton[class="primary"] {
background-color: #1976d2;
color: #ffffff;
border: 2px solid #1565c0;
border-radius: 4px;
padding: 4px 14px;
}

QPushButton[class="primary"]:hover {
background-color: #1565c0;
color: #ffffff;
border: 2px solid #0d47a1;
}

QPushButton[class="primary"]:pressed {
background-color: #0d47a1;
color: #ffffff;
border: 2px solid #08306b;
}

QPushButton[class="primary"]:disabled {
background-color: #bbdefb;
color: #7691b0;
border: 2px solid #bbdefb;
}

QToolButton {
background-color: #cccccc;
font: bold;
font-size: $FONTSIZEPLACEHOLDER*1.5;
}

QToolTip {
font: $FONTPLACEHOLDER;
font-size: $FONTSIZEPLACEHOLDER*1;
}
